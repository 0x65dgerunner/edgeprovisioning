                pause
                ;;

            5)
                df -ih
                pause
                ;;

            6)
                ps aux --sort=-%cpu | head -n 20
                pause
                ;;

            7)
                ip -brief address
                echo
                ip route
                pause
                ;;

            8)
                if command_exists ss; then
                    ss -tulpn
                else
                    netstat -tulpn
                fi
                pause
                ;;

            9)
                systemctl --failed
                pause
                ;;

            10)
                uptime -s
                echo
                systemd-analyze
                pause
                ;;

            11)
                uname -a
                pause
                ;;

            12)
                env | sort | less
                ;;

            13)
                if command_exists apt; then
                    apt update
                    echo

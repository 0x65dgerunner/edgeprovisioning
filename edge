security_osv() {

    header "OSV-SCANNER"

    if ! command_exists osv-scanner; then
        warn "osv-scanner não está instalado."
        echo
        echo "Você pode instalá-lo pelo menu Instalação (opção 7)."
        echo
        pause
        return
    fi

    echo "Escolha o diretório do projeto."
    echo

    read -rp "Directory [.]: " TARGET

    TARGET="${TARGET:-.}"

    if [ ! -d "$TARGET" ]; then
        error "Directory not found."
        pause
        return
    fi

    echo
    info "Scanning: $TARGET"
    echo

    osv-scanner scan source -r "$TARGET"

    pause
}

security_menu() {

    while true; do

        header "SECURITY"

        echo "[1] OSV-Scanner"
        echo "[2] Lynis"
        echo "[3] Listening ports"
        echo "[4] SSH configuration"
        echo "[5] Failed SSH logins"
        echo "[6] SUID files"
        echo "[7] SGID files"
        echo "[8] World-writable files"
        echo "[9] Failed services"
        echo "[10] Authentication logs"
        echo "[11] Firewall status"
        echo "[12] Pending security updates"
        echo "[13] Kernel security parameters"
        echo "[14] Users with shell"
        echo "[0] Back"
        echo

        read -rp "Select: " OPTION

        case "$OPTION" in

            1)
                security_osv
                ;;

            2)
                if command_exists lynis; then
                    lynis audit system
                else
                    warn "Lynis não está instalado."
                    echo
                    echo "Install with your distribution package manager."
                fi

                pause
                ;;

            3)
                ss -tulpn
                pause
                ;;

            4)
                if [ -f /etc/ssh/sshd_config ]; then
                    grep -Ev '^[[:space:]]*(#|$)' \
                        /etc/ssh/sshd_config
                else
                    warn "/etc/ssh/sshd_config not found."
                fi

                pause
                ;;

            5)
                echo "Recent failed authentication attempts:"
                echo

                if command_exists journalctl; then
                    journalctl \
                        _SYSTEMD_UNIT=sshd.service \
                        --no-pager 2>/dev/null |
                    grep -Ei \
                        'failed|invalid user|authentication failure' |
                    tail -n 50
                fi

                if [ -f /var/log/auth.log ]; then
                    grep -Ei \
                        'failed|invalid user|authentication failure' \
                        /var/log/auth.log |
                    tail -n 50
                fi

                pause
                ;;

            6)
                info "Searching SUID files..."
                find / \
                    -xdev \
                    -type f \
                    -perm -4000 \
                    -print \
                    2>/dev/null |
                    sort

                pause
                ;;

            7)
                info "Searching SGID files..."
                find / \
                    -xdev \
                    -type f \
                    -perm -2000 \
                    -print \
                    2>/dev/null |
                    sort

                pause
                ;;

            8)
                info "Searching world-writable files..."
                find / \
                    -xdev \
                    -type f \
                    -perm -0002 \
                    -print \
                    2>/dev/null |
                    head -n 200

                pause
                ;;

            9)
                systemctl --failed
                pause
                ;;

            10)
                if command_exists journalctl; then
                    journalctl \
                        --since "24 hours ago" \
                        --no-pager |
                    grep -Ei \
                        'authentication|failed password|invalid user|sudo|session opened|session closed' |
                    tail -n 100
                fi

                pause
                ;;

            11)
                if command_exists ufw; then
                    ufw status verbose
                elif command_exists firewall-cmd; then
                    firewall-cmd --state
                    firewall-cmd --list-all
                elif command_exists nft; then
                    nft list ruleset
                elif command_exists iptables; then
                    iptables -L -n -v
                else
                    warn "No supported firewall tool found."
                fi

                pause
                ;;

            12)
                if command_exists apt; then
                    apt list --upgradable 2>/dev/null
                elif command_exists dnf; then
                    dnf updateinfo list security
                else
                    warn "Package manager not supported."
                fi

                pause
                ;;

            13)
                echo "ASLR:"
                sysctl kernel.randomize_va_space 2>/dev/null || true

                echo
                echo "Core dumps:"
                sysctl kernel.core_pattern 2>/dev/null || true

                echo
                echo "dmesg restrictions:"
                sysctl kernel.dmesg_restrict 2>/dev/null || true

                echo
                echo "Unprivileged BPF:"
                sysctl kernel.unprivileged_bpf_disabled 2>/dev/null || true

                pause
                ;;

            14)
                awk -F: '
                    $7 ~ /(bash|sh|zsh|fish|ksh)$/ {
                        print $1 ":" $7
                    }
                ' /etc/passwd

                pause
                ;;

            0)
                return
                ;;

            *)
                error "Invalid option."
                sleep 1
                ;;
        esac

    done
}

